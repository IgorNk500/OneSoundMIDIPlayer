root = true

[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{py,pyx,pxd,pyi}]
indent_size = 4

[*.txt]
indent_size = 0
indent_style = tab
trim_trailing_whitespace = false

[*.md]
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false
