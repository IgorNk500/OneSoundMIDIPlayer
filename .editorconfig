root = true

[*]
    charset = utf-8
    indent_style = tab
    indent_size = 1
    trim_trailing_whitespace = true
    end_of_line = lf
    insert_final_newline = true

[*.{py,pyx,pxd,pyi,cpp,h,hpp}]
    indent_style = space
    indent_size = 4

[*.{txt,gitignore}]
    trim_trailing_whitespace = false

[*.md]
    trim_trailing_whitespace = false
    insert_final_newline = false

[.{gitmodules,editorconfig}]
    indent_style = space
    indent_size = 4
    trim_trailing_whitespace = false
